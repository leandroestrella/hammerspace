# Copia questo file in ".env" e compila i valori, poi caricali con:
#   export $(grep -v '^#' .env | xargs)
# NON committare mai il file .env reale (contiene segreti).

# --- cPanel (obbligatorio per gli step 1 e 4) ---
# Crea il token da: cPanel -> Security -> Manage API Tokens -> Create
CPANEL_HOST=server.leandroestrella.com
CPANEL_USER=nomeutente_cpanel
CPANEL_API_TOKEN=incolla_qui_il_token

# Dominio radice e IP del server (dal documento Confluence)
ROOT_DOMAIN=leandroestrella.com
SERVER_IP=207.180.240.84

# --- WHM (facoltativo, solo per lo step 3 - AutoSSL) ---
# Serve un token WHM (accesso root/reseller), diverso dal token cPanel utente.
# Se non lo hai, lascia vuoto: lo script salta lo step e lo segnala.
WHM_HOST=server.leandroestrella.com
WHM_USER=root
WHM_API_TOKEN=

# --- Namecheap (obbligatorio per lo step 2) ---
# Abilita l'API da: Namecheap -> Profile -> Tools -> "API Access" -> On
# Devi anche mettere in whitelist l'IP pubblico da cui esegui lo script
# (Namecheap -> API Access -> Whitelisted IPs).
NAMECHEAP_API_USER=tuo_username_namecheap
NAMECHEAP_API_KEY=incolla_qui_la_api_key
NAMECHEAP_USERNAME=tuo_username_namecheap
NAMECHEAP_CLIENT_IP=1.2.3.4

# --- GitHub (obbligatorio solo per setup_autodeploy.py e setup_gitflow.py) ---
# Personal Access Token con cui scrivere sul repository DI DESTINAZIONE:
# classico con scope "repo" + "workflow", oppure fine-grained con
# "Secrets: write", "Contents: write" e "Workflows: write" su quel repository.
#
# NB: si chiama GITHUB_PAT e non GITHUB_TOKEN di proposito - dentro Actions
# GITHUB_TOKEN esiste sempre ed e' il token di QUESTO repository, che sul
# repository di destinazione non puo' scrivere niente.
GITHUB_PAT=

# --- PostHog (facoltativo, solo per gli Authorized URLs) ---
# Web analytics mostra solo i domini negli Authorized URLs del progetto:
# create_subdomain.py aggiunge li' il nuovo sottodominio (e lo toglie con
# --delete). Serve una PERSONAL API key (phx_...) con scope "project:write":
# PostHog -> Settings -> Personal API keys. NON e' la chiave phc_ dello snippet.
# Se la lasci vuota, lo script salta lo step e dice cosa aggiungere a mano.
POSTHOG_PERSONAL_API_KEY=
# Valori di default gia' nello script, da cambiare solo per un altro progetto:
# POSTHOG_HOST=https://eu.posthog.com
# POSTHOG_PROJECT_ID=139609
